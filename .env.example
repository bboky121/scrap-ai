# Shared
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/kisbrief
VALKEY_URL=redis://valkey:6379/0
INTERNAL_SERVICE_TOKEN=change-me
DISCORD_WEBHOOK_URL=

# KIS production API. If blank, the Python pipeline uses DEMO_FIXTURE data.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_TOP_STOCK_COUNT=20
KIS_REQUEST_DELAY_SECONDS=0.5
KIS_NEWS_DELAY_SECONDS=0.25
KIS_INGEST_LOCK_TTL_SECONDS=900
KIS_REQUESTS_PER_SECOND=15
KIS_BASE_URL=https://openapi.koreainvestment.com:9443

# Web/API
API_PORT=4000
API_PUBLIC_URL=http://localhost:4100
API_URL=http://api:4000
NEXT_PUBLIC_API_URL=http://localhost:4100
WEB_URL=http://localhost:3100
SESSION_SECRET=change-me-to-at-least-32-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
DEMO_AUTH_ENABLED=true

# Mobile push (Firebase Cloud Messaging)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
MOBILE_DEEP_LINK_SCHEME=kisbrief
# Expo development app URL; use a LAN IP, not localhost, on a physical device.
EXPO_PUBLIC_WEB_URL=http://192.168.0.10:3100
EXPO_PUBLIC_API_URL=http://192.168.0.10:4100
