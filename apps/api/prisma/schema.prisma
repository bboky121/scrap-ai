generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}
datasource db {
  provider = "postgresql"
}

enum ArticleKind {
  NEWS
  DISCLOSURE
  MARKET_COMMENTARY
}
enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}
enum IngestionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  DEMO_FIXTURE
}
enum PlanCode {
  WEEK
  MONTH
  YEAR
}
enum PaymentStatus {
  SUCCEEDED
  FAILED
}
enum SubscriptionStatus {
  ACTIVE
  EXPIRED
}

model User {
  id String @id @default(cuid())
  email String @unique
  name String
  provider String @default("demo")
  providerId String?
  createdAt DateTime @default(now())
  subscriptions Subscription[]
  payments PaymentAttempt[]
}

model Article {
  id String @id @default(cuid())
  externalId String @unique
  kind ArticleKind
  title String
  provider String
  publishedAt DateTime
  stockCode String?
  sourceUrl String?
  bodyExcerpt String?
  raw Json
  createdAt DateTime @default(now())
  summary ArticleSummary?
  briefings BriefingArticle[]
  @@index([publishedAt(sort: Desc)])
}

model ArticleSummary {
  id String @id @default(cuid())
  articleId String @unique
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  bullets Json
  keywords Json
  relatedStocks Json
  sentiment Sentiment
  titleOnly Boolean @default(true)
  createdAt DateTime @default(now())
}

model HourlyBriefing {
  id String @id @default(cuid())
  bucketAt DateTime @unique
  headline String
  keyIssues Json
  marketImpact String
  watchStocks Json
  createdAt DateTime @default(now())
  articles BriefingArticle[]
}

model BriefingArticle {
  briefingId String
  articleId String
  briefing HourlyBriefing @relation(fields: [briefingId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  @@id([briefingId, articleId])
}

model Plan {
  code PlanCode @id
  name String
  price Int
  durationUnit String
  durationCount Int
  subscriptions Subscription[]
  payments PaymentAttempt[]
}

model PaymentAttempt {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  planCode PlanCode
  plan Plan @relation(fields: [planCode], references: [code])
  amount Int
  status PaymentStatus
  cardLast4 String
  failureReason String?
  createdAt DateTime @default(now())
}

model Subscription {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  planCode PlanCode
  plan Plan @relation(fields: [planCode], references: [code])
  status SubscriptionStatus
  startsAt DateTime
  endsAt DateTime
  autoRenew Boolean @default(false)
  canceledAt DateTime?
  createdAt DateTime @default(now())
  events SubscriptionEvent[]
  @@index([userId, status, endsAt])
}

model SubscriptionEvent {
  id String @id @default(cuid())
  subscriptionId String
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  type String
  detail Json
  createdAt DateTime @default(now())
}

model IngestionRun {
  id String @id
  status IngestionStatus
  source String
  fetchedCount Int @default(0)
  savedCount Int @default(0)
  error String?
  startedAt DateTime @default(now())
  finishedAt DateTime?
}
