{
  "name": "kis-brief",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm test:node && pnpm test:python",
    "test:node": "pnpm -r test",
    "test:python": "apps/pipeline/.venv/bin/pytest apps/pipeline/tests",
    "format": "pnpm format:node && pnpm format:python",
    "format:check": "pnpm format:node:check && pnpm format:python:check",
    "format:node": "prettier --write \"apps/**/*.{ts,tsx,js,jsx,json,css,md,yml,yaml}\" \"*.{json,md,yml,yaml}\"",
    "format:node:check": "prettier --check \"apps/**/*.{ts,tsx,js,jsx,json,css,md,yml,yaml}\" \"*.{json,md,yml,yaml}\"",
    "format:python": "./scripts/ruff check --fix apps/pipeline && ./scripts/ruff format apps/pipeline",
    "format:python:check": "./scripts/ruff check apps/pipeline && ./scripts/ruff format --check apps/pipeline",
    "db:generate": "pnpm --filter @kis/api prisma:generate",
    "db:migrate": "pnpm --filter @kis/api prisma:migrate",
    "db:seed": "pnpm --filter @kis/api prisma:seed",
    "mobile:android:setup": "./scripts/setup-android-sdk.sh"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.4.0"
  }
}
